<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="IRONBIT" android:textColor="#FFF2B84B" android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.1"/>
        <TextView android:id="@+id/w_level" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LV 1" android:textColor="#FF3FC1B0" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/w_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="6dp" android:max="100" android:progress="0" android:progressTint="#FFF2B84B" android:progressBackgroundTint="#FF3A3446"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_streak" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="🔥 0" android:textColor="#FFF6E9D0" android:textSize="20sp" android:textStyle="bold" android:fontFamily="monospace"/>
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/wizard_face" android:contentDescription="Merlift"/>
    </LinearLayout>
    <TextView android:id="@+id/w_plan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="Open IronBit to start" android:textColor="#FFCFC8BB" android:textSize="12sp" android:fontFamily="monospace" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
